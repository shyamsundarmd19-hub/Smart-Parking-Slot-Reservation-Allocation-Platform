# Server Configuration
PROJECT_NAME="ParkCloud API"
SECRET_KEY="replace_with_a_secure_random_string_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (AWS RDS PostgreSQL or Local Postgres)
# AWS RDS Free Tier: db.t3.micro or db.t4g.micro (20GB gp2/gp3)
DATABASE_URL="postgresql://postgres:YourSecurePassword@localhost:5432/parkcloud"

# AWS Configuration (IAM User with AmazonS3FullAccess & AmazonSESFullAccess or attached EC2 IAM Role)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME="parkcloud-passes-bucket"
AWS_SES_SENDER_EMAIL="notifications@yourdomain.com"
